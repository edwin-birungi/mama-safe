# Copy these into your hosting environment (the app reads real environment variables, not this file).

PORT=3000
MAMASAFE_ENV=production          # "development" loads fake sample facilities and shows sign-in codes on screen
MAMASAFE_DB=data/mamasafe.db     # keep on persistent storage and back it up
TRUST_PROXY=true                 # when behind a reverse proxy / platform load balancer

# Facility dashboard (required in production)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-a-long-random-password

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false                 # true while testing with the AT sandbox
WEBHOOK_KEY=change-me-random     # add ?key=... to the USSD and SMS callback URLs

# What mothers see
USSD_CODE=*123#                  # replace with the code you are really assigned
SMS_NUMBER=                      # shortcode mothers text, e.g. 21234
EMERGENCY_NUMBER=999
DEFAULT_COUNTRY_CODE=256

# Reminder window, hours in local time, and the local offset from UTC (East Africa = 3)
REMINDER_FROM_HOUR=8
REMINDER_TO_HOUR=19
UTC_OFFSET_HOURS=3
