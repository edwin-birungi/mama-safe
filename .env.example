# Copy these into your hosting environment (the app reads real environment variables, not this file).

PORT=3000
MAMASAFE_ENV=production          # "development" shows sign-in codes on screen and leaves the dashboard open
MAMASAFE_DB=data/mamasafe.db     # keep on persistent storage and back it up
TRUST_PROXY=true                 # when behind a reverse proxy / platform load balancer

# Google Maps JavaScript API key, restricted to your site (HTTP referrers). Optional: falls back to OpenStreetMap.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID        # create a Map ID in Google Cloud for production

# Facility dashboard (required in production)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-to-a-long-random-password

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false                 # true while testing with the AT sandbox
WEBHOOK_KEY=change-me-random     # add ?key=... to the USSD and SMS callback URLs

# What mothers see
USSD_CODE=*123#                  # replace with the code you are really assigned
SMS_NUMBER=                      # shortcode mothers text, e.g. 21234
EMERGENCY_NUMBER=999
DEFAULT_COUNTRY_CODE=256

# Reminder window, hours in local time, and the local offset from UTC (East Africa = 3)
REMINDER_FROM_HOUR=8
REMINDER_TO_HOUR=19
UTC_OFFSET_HOURS=3

# Emergency transport: nearest registered drivers are texted when a mother sends an alert
TRANSPORT_AUTO_DISPATCH=true     # false keeps the directory but sends nothing
TRANSPORT_DISPATCH_COUNT=3       # how many drivers are asked per alert

# Payments (optional). ENROLMENT_FEE=0 keeps everything free. Emergency help is always free.
ENROLMENT_FEE=0                  # e.g. 43000 (in PAYMENT_CURRENCY)
PAYMENT_CURRENCY=UGX
PUBLIC_URL=                      # https://your-domain  (return link after paying)
FLW_SECRET_KEY=                  # Flutterwave secret key (test first)
FLW_SECRET_HASH=                 # same value as the webhook "secret hash" in the Flutterwave dashboard
PAYMENT_OPTIONS=card,mobilemoneyuganda
PAYMENT_EMAIL_DOMAIN=example.com # a domain you own; used as <phone>@domain because mothers rarely give an email

# MTN MoMo Collections (prompt on the mother's phone; works from USSD and SMS)
MOMO_SUBSCRIPTION_KEY=           # Collection product subscription key
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox          # "mtnuganda" in production. In sandbox set PAYMENT_CURRENCY=EUR
MOMO_CALLBACK_KEY=               # long random string, becomes /webhooks/momo/<key>

# Airtel Money collections (prompt on the mother's phone)
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENV=sandbox               # "production" for live
AIRTEL_COUNTRY=UG
AIRTEL_CALLBACK_KEY=             # long random string, becomes /webhooks/airtel/<key>

# Demo / developer access for a remote tester who cannot receive SMS (leave both empty to switch it off).
# The tester signs in with one of the DEMO_PHONES and the DEMO_CODE instead of an SMS code.
# Demo accounts are sandboxed: no SMS, alert, driver request or question ever reaches a real person.
# Use made-up numbers only. NEVER list a real person's number: the code would let anyone sign in as them.
# The code must be at least 8 characters. Change it or empty it when testing is over.
DEMO_CODE=
DEMO_PHONES=              # e.g. 0700000001,0700000002
